# =======================================================================
# Git Ignore
# =======================================================================
# Purpose: Prevent build artifacts, local config, and sensitive
#          credentials from entering version control.
# Scope:   Project-wide Python, Node, and Windows desktop app runtime files.
# =======================================================================

# ----------------------------------------------------------------------
# Python app runtime
# ----------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
.env
.env.*
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Kabir reminder app runtime state
.kabir_reminder.lock

# ----------------------------------------------------------------------
# Dependency Managers (Node)
# ----------------------------------------------------------------------
.pnp/
.pnp.*
.bun/
node_modules/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ----------------------------------------------------------------------
# Dependencies (Php)
# ----------------------------------------------------------------------
/languages
vendor/

# ----------------------------------------------------------------------
# Go
# ----------------------------------------------------------------------
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work
go.work.sum

# ----------------------------------------------------------------------
# Build & Compilation Output
# ----------------------------------------------------------------------
.next/
/out/
.svelte-kit/
*.tsbuildinfo
next-env.d.ts
/build/
/dist/

# ----------------------------------------------------------------------
# Cache Directories
# ----------------------------------------------------------------------
.cache/
.gulp/
.parcel-cache/
.phpcs-cache
.postcssrc
.rollup.cache/
.turbo/
.vite/
.vitest/
.webpack/
.eslintcache
.ruff_cache
.stylelintcache

# ----------------------------------------------------------------------
# Testing & Coverage
# ----------------------------------------------------------------------
.nyc_output/
coverage/
.jest/
blob-report/
playwright-report/
test-results/
vitest-results/

# ----------------------------------------------------------------------
# Editor & IDE Settings
# ----------------------------------------------------------------------
.idea/
.vscode/
.vscode-insiders/
*.swp
*.swo

# Vim
[._]*.s[a-v][a-z]
!*.svg
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
Session.vim
Sessionx.vim
.netrwhist
[._]*.un~

# ----------------------------------------------------------------------
# System & OS Junk
# ----------------------------------------------------------------------
.AppleDouble
.DS_Store
.LSOverride
.Spotlight-V100
.Trashes
.AppleDB
.AppleDesktop
.DocumentRevisions-V100
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
Icon
._*
Network Trash Folder
Temporary Items
.apdisk
$RECYCLE.BIN/
Desktop.ini
Thumbs.db
ehthumbs.db
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ----------------------------------------------------------------------
# Deployment
# ----------------------------------------------------------------------
.wrangler/
.netlify/
.vercel/

# ----------------------------------------------------------------------
# Log Files
# ----------------------------------------------------------------------
*.log
npm-debug.log*
pnpm-debug.log*
pnpm-error.log*

# Yarn
yarn-debug.log*
yarn-error.log*

# Bun
bun-debug.log*
bun-error.log*

# Next.js / Nuxt
.nuxt/

# Python
*.pyc
*.pyo
__pycache__/
.tox/

# PHP
error_log
php-error.log
wp-content/debug.log
wp-content/uploads/debug.log

# Laravel / Symfony / Rails / Django
/storage/logs/
/log/
/logs/

# ----------------------------------------------------------------------
# Nix
# ----------------------------------------------------------------------
result
result-*

# ----------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------
*.rdb

# PM2 / Forever / Process Managers
*.log.*
.pm2/

# Syslog
syslog/
syslog.log

# ----------------------------------------------------------------------
# Temporary Files
# ----------------------------------------------------------------------
# Scratch data, prepared commands, local workflow artifacts.
.tmp/
tmp/
coverage.txt

